<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatorApp.MainPage">

    <ScrollView>
        <StackLayout Padding="20">

            <!-- Titel -->
            <Label Text="Calculator" FontSize="24" HorizontalOptions="Center" />

            <!-- Invoer velden -->
            <Entry x:Name="Input1" Placeholder="Enter first number" Keyboard="Numeric" />
            <Entry x:Name="Input2" Placeholder="Enter second number" Keyboard="Numeric" />

            <!-- Grid voor de knoppen -->
            <Grid ColumnSpacing="10" RowSpacing="10" Margin="0,20,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Knoppen voor berekeningen -->
                <Button x:Name="CalculateSum" Text=" + " Grid.Row="0" Grid.Column="0" Clicked="OnCalculate" />
                <Button x:Name="CalculateDifference" Text=" - " Grid.Row="0" Grid.Column="1" Clicked="OnCalculate" />
                <Button x:Name="CalculateProduct" Text=" * " Grid.Row="0" Grid.Column="2" Clicked="OnCalculate" />
                <Button x:Name="CalculateQuotient" Text=" / " Grid.Row="0" Grid.Column="3" Clicked="OnCalculate" />
                <Button x:Name="CalculateRemainder" Text=" % " Grid.Row="0" Grid.Column="4" Clicked="OnCalculate" />
                <Button x:Name="CalculateAll" Text=" All " Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Clicked="CalculateAll_Clicked" />
            </Grid>

            <!-- Label voor de uitkomst -->
            <Label x:Name="ResultLabel" Text="De uitkomst verschijnt hier" FontSize="18" HorizontalOptions="Center" Margin="15" />

        </StackLayout>
    </ScrollView>
</ContentPage>
